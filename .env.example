# 仅作名称清单；CI 从 GitHub Repository Secrets / Variables 读取。
# 不要复制源码仓库根目录的完整后端 .env 到本仓库。
SOURCE_GIT_URL=
SOURCE_GIT_USERNAME=
SOURCE_GIT_TOKEN=
SOURCE_GIT_CA_CERT_BASE64=
ANDROID_PACKAGE_NAME=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
APPLE_TEAM_ID=
IOS_APP_BUNDLE_ID=
IOS_PROJECT_NAME=
IOS_DISTRIBUTION_CERT_BASE64=
IOS_CERT_PASSWORD=
IOS_PROFILE_APP_BASE64=
IOS_PROFILE_ADHOC_BASE64=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
ASC_API_KEY_P8_BASE64=
ASC_KEY_ID=
ASC_ISSUER_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=mobile/appUpdate
GOOGLE_SERVICES_PROD_JSON_BASE64=
FEISHU_RELEASE_WEBHOOK_URL=
FEISHU_RELEASE_WEBHOOK_SECRET=
# 以下是 Repository Variables，公开下载默认关闭
UPLOAD_BUILD_ARTIFACTS=false
ARCHIVE_RELEASE=false
